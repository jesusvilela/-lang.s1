  non_scope     = Euclidean_tilings_dynamics_individual_tile_dynamics_covered_by_Substrate_Swirl
  generates     = §TILE, §GROUP_ELT, §QUOTIENT, §RING_k, §FUNDAMENTAL_DOMAIN
