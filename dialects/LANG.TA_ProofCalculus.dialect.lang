§|LANG|TA_OPERATORS{
  PARSE                     : String → FORMULA
                              [parse_surface_syntax_into_abstract_syntax_tree]
  DEPTH                     : FORMULA → ℕ
                              [compute_max_□_nesting_depth]
  SUBFORMULAS               : FORMULA → Set<FORMULA>
                              [return_all_subformulas_including_self]
  SUBSTITUTE                : FORMULA × Atom × FORMULA → FORMULA
                              [replace_atom_p_with_formula_ψ_throughout]
  
  APPLY_MP                  : DERIV<φ→ψ> × DERIV<φ> → DERIV<ψ>
                              [modus_ponens_inference_rule]
  APPLY_NEC                 : DERIV<φ> → DERIV<□_A φ>
                              [necessitation_inference_rule]
  APPLY_AXIOM               : AxiomSchema × Substitution → DERIV<instance>
                              [axiom_instantiation]
  
  VERIFY_DERIVATION         : DERIVATION → Bool
                              [check_every_step_against_axioms_and_rules]
  DERIVE_LÖB                : FORMULA → DERIV<□_A(□_A φ→φ)→□_A φ>
                              [instantiate_Löb_theorem_template_for_given_φ]
  
  PROOF_SEARCH              : Memory × DepthBudget → Option<DERIVATION>
                              [bounded_proof_search_as_per_step_B_above]
  FIRE_LÖB_EVENT            : Agent × DERIVATION → Agent'
                              [update_agent_state_with_verified_new_theorem]
  
  CONSISTENCY_CHECK         : Agent → Bool
                              [verify_no_⊥_derivable_from_current_proof_atoms]
  ROLLBACK                  : Agent × ProofAtoms_snapshot → Agent
                              [restore_agent_to_last_consistent_state]
}

