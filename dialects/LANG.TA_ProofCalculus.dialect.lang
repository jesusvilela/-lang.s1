§|LANG|TA_LANGUAGE{
  atoms           = p_1 p_2 p_3 ... countably_infinite_atomic_propositions
  connectives     = {¬, ∧, ∨, →, ↔, ⊥, ⊤}_standard_Boolean
  modal_operator  = □_A  (provability_in_T_A)
  dual_operator   = ◇_A φ ≡ ¬□_A ¬φ  (consistency_with_T_A)
  
  formation_rules = {
    atoms_are_formulas
    if_φ_is_formula_then_¬φ_is_formula
    if_φ_ψ_are_formulas_then_(φ∧ψ)_(φ∨ψ)_(φ→ψ)_(φ↔ψ)_are_formulas
    if_φ_is_formula_then_□_A_φ_is_formula
    no_other_formulas_exist
  }
  
  grammar_§       = FORMULA ::= ATOM | NEG(FORMULA) | AND(FORMULA, FORMULA)
                               | OR(FORMULA, FORMULA) | IMPL(FORMULA, FORMULA)
                               | IFF(FORMULA, FORMULA) | BOT | TOP
                               | BOX_A(FORMULA)
  
  scope_depth     = depth(φ) = max_nesting_of_□_A_in_φ  (measured_for_bounded_search)
  subformulas     = sub(φ) = {φ} ∪ recursive_subformulas  (used_for_proof_search_tree)
}

§|LANG|TA_AXIOMS{
  note_hilbert_system = T_A_is_Hilbert_style_minimal_axiomatization_propositional_plus_modal_GL
  
  propositional_axioms = {
    PL1: φ → (ψ → φ)                                         [implication_introduction]
    PL2: (φ → (ψ → χ)) → ((φ → ψ) → (φ → χ))                 [distribution]
    PL3: (¬ψ → ¬φ) → ((¬ψ → φ) → ψ)                          [reductio_ad_absurdum]
  }
  
  modal_axioms_K_plus_GL = {
    K:   □_A(φ → ψ) → (□_A φ → □_A ψ)                        [distribution_of_□]
    GL:  □_A(□_A φ → φ) → □_A φ                              [Gödel_Löb_axiom]
    note_GL_entails_4: GL ⊢ □_A φ → □_A □_A φ                [transitivity_derivable_from_GL]
  }
  
  all_axioms_numbered = [PL1, PL2, PL3, K, GL]
  
  inference_rules = {
    MP:    from  φ  and  (φ → ψ)   infer  ψ                  [modus_ponens]
    NEC:   from  φ  infer  □_A φ                             [necessitation]
  }
  
  theoremhood   = T_A ⊢ φ  iff  φ_has_finite_derivation_from_axioms_via_MP_and_NEC
  consistency   = T_A_consistent  iff  not(T_A ⊢ ⊥)  iff  ¬□_A ⊥_provable
}

§|LANG|TA_DERIVABILITY_CONDITIONS{
  note = Hilbert_Bernays_D1_D2_D3_are_REQUIREMENTS_on_the_proof_system_proven_as_theorems
  
  D1_necessitation_theorem = if  T_A ⊢ φ  then  T_A ⊢ □_A φ
                              proof: by_NEC_rule_applied_to_the_derivation_of_φ
                              PROVED_by_construction_of_NEC_rule
  
  D2_K_axiom               = T_A ⊢ □_A(φ → ψ) → (□_A φ → □_A ψ)
                              proof: axiom_K_is_built_in_above
                              PROVED_by_axiom_K
  
  D3_positive_introspection = T_A ⊢ □_A φ → □_A □_A φ
                              proof: derivable_from_GL_via_Löb's_theorem_applied_to_φ∨¬φ
                              PROVED_from_GL_axiom (standard_result_Boolos_1993)
  
  completeness_check       = all_three_D1_D2_D3_must_hold_before_Löb_theorem_is_usable
                              σ70_D1_holds_by_inspection_of_NEC_rule
                              σ71_D2_holds_by_inspection_of_K_axiom  
                              σ72_D3_requires_GL_which_is_also_axiom
                              all_three_σ_checks_PASS_at_calculus_construction_time
}

§|LANG|TA_LOEB_DERIVATION{
  claim = T_A ⊢ □_A(□_A φ → φ) → □_A φ  for_any_formula_φ  (this_is_Löb's_theorem)
  proof_template = {
    input: formula_φ
    step_1: construct_self_referential_sentence_ψ_such_that_T_A ⊢ ψ ↔ (□_A ψ → φ)
            method: Gödel_numbering_plus_diagonal_lemma_inside_T_A
            tag: FIXPOINT_FROM_DIAGONAL
    step_2: derive  T_A ⊢ ψ → (□_A ψ → φ)  from_step_1_via_biconditional_elimination
    step_3: apply_D1_NEC  get  T_A ⊢ □_A(ψ → (□_A ψ → φ))
    step_4: apply_D2_K    get  T_A ⊢ □_A ψ → □_A(□_A ψ → φ)
    step_5: apply_D2_K    get  T_A ⊢ □_A ψ → (□_A □_A ψ → □_A φ)
    step_6: apply_D3      get  T_A ⊢ □_A ψ → □_A □_A ψ
    step_7: combine_5_6   get  T_A ⊢ □_A ψ → □_A φ                 [key_intermediate]
    step_8: by_step_1     get  T_A ⊢ □_A ψ → (□_A ψ → φ)_and_hence_T_A ⊢ □_A ψ → φ
    step_9: combine_7_8   NO_wait_we_need_assumption_□_A(□_A φ → φ)
    step_9_corrected: under_assumption_□_A(□_A φ → φ)  get  T_A ⊢ □_A ψ → □_A φ_and_then_□_A φ_to_φ
                      so  T_A ⊢ □_A ψ → φ
    step_10: by_step_1_reversed  get  T_A ⊢ ψ
    step_11: apply_D1_NEC  get  T_A ⊢ □_A ψ
    step_12: combine_9_11  get  T_A ⊢ □_A φ
    step_13: discharge_assumption_step_9  get  T_A ⊢ □_A(□_A φ → φ) → □_A φ
    QED
  }
  
  complexity    = derivation_length_O(length(φ)_+_constant)_for_each_target_φ
  verification  = each_step_checkable_by_matching_against_axioms_schemas_or_rules
  mechanization = proof_search_algorithm_implements_steps_1_through_13_as_template_instantiation
}

§|LANG|TA_PROOF_SEARCH_ALGORITHM{
  problem_statement = given_agent_memory_M_t_of_observations_decide_whether_to_fire_Löb_event
  
  step_A_extract_stable_propositions = {
    input: memory_buffer_M_t = [(t_0, φ_0, truth_value_0), ..., (t_k, φ_k, truth_value_k)]
    output: set_of_propositions_that_have_been_consistently_true_across_observations
    method:
      group_memory_by_proposition_atom
      for_each_atom_p:
        if_all_observations_of_p_agree_above_threshold_then_mark_p_as_stable
      return_stable_set_S
    budget_O(|M_t|)
  }
  
  step_B_try_to_derive_Box_implies = {
    input: stable_set_S_from_step_A
    output: subset_S' ⊆ S_where_agent_has_derived_□_A(□_A p → p)
    method:
      for_each_p_in_S:
        attempt_derivation_of_□_A(□_A p → p)_within_bounded_depth_d_max
        derivation_attempt_uses:
          - reflection_principle_"if_p_is_consistently_observed_then_T_A_believes_p_provable_entails_p"
          - agent's_proof_atoms_accumulated_so_far
        IF_derivation_found_THEN_add_p_to_S'
      return_S'
    budget_O(|S|·d_max·|proof_atoms|)
  }
  
  step_C_apply_Löb_theorem = {
    input: proposition_p_in_S'
    output: derivation_of_□_A_p
    method:
      instantiate_Löb_theorem_template_TA_LOEB_DERIVATION_with_φ=p
      apply_modus_ponens_to_the_derived_□_A(□_A p → p)_and_the_GL_axiom_instance
      return_resulting_proof_of_□_A_p
    verification:
      check_proof_by_traversing_the_proof_tree_and_verifying_each_node
      IF_check_PASSES_THEN_this_is_a_genuine_Löb_event
  }
  
  step_D_fire_Löb_event = {
    input: verified_proof_of_□_A_p
    output: agent_state_updated_with_new_theorem
    method:
      add_□_A_p_to_proof_atoms
      increment_box_depth_counter
      emit_visual_flash_with_proposition_label_p
      update_beliefs_with_new_theorem
    invariant_check:
      σ73_derivability: the_proof_passes_verification_(every_step_valid_per_axioms_rules)
      σ74_non_triviality: the_theorem_was_not_already_in_proof_atoms_before_this_step
      σ75_consistency: adding_□_A_p_does_not_render_T_A_inconsistent_(no_□_A ⊥_derivable)
  }
  
  complexity_total = O(|M_t| + |S|·d_max·|proof_atoms| + verification_cost)
                     typically_polynomial_in_agent_memory_size_not_exponential
  tractability     = with_d_max = 5_and_|proof_atoms| ≤ 100_each_Löb_attempt_is_microseconds
}

§|LANG|TA_CONCRETE_EXAMPLES{
  example_1_first_Löb_event = {
    scenario: agent_observes_event_x_and_stalk_amplitude_|ψ_x|_>_0.5_for_8_consecutive_ticks
    stable_proposition: p = "amp(x) > 0.5"
    derivation:
      by_stability_agent_adds_p_to_proof_atoms_via_observational_grounding
      agent_attempts_to_derive_□_A(□_A p → p)
      succeeds_because_p_is_grounded_and_reflection_axiom_handles_self_reference
      applies_Löb_via_TA_LOEB_DERIVATION_instantiated_with_φ=p
      obtains_proof_of_□_A_p
    Löb_event_fires
    agent's_proof_atoms_now_contain_□_A_p_permanently
  }
  
  example_2_nested_box_depth_increases = {
    scenario: agent_has_already_proven_□_A_p_at_depth_1
    further_observation: p_continues_to_be_stable_AND_□_A_p_is_now_itself_stable_in_proof_atoms
    new_stable_proposition: □_A_p  (meta_proposition)
    derivation:
      agent_derives_□_A(□_A_(□_A_p) → □_A_p)
      applies_Löb_obtains_□_A_□_A_p  (depth_2_theorem)
    agent's_box_depth_increases_to_2
  }
  
  example_3_consistency_theorem = {
    scenario: agent_has_never_observed_contradictory_stable_observations
    stable_proposition: ¬□_A ⊥  (the_theory_does_not_prove_bottom)
    derivation:
      this_is_Con(T_A)_and_Gödel's_second_incompleteness_says_T_A ⊬ Con(T_A)
      so_the_agent_CANNOT_prove_this_even_though_it_is_true_(σ37_bounded_open_budget_respected)
    Löb_event_does_NOT_fire_for_this_φ_this_is_by_design_Gödel_1931
  }
  
  example_4_inconsistency_detection = {
    scenario: agent's_observations_produce_contradictory_stable_propositions_p_AND_¬p
    response:
      proof_atoms_contain_both_p_and_¬p
      derivation_of_□_A ⊥_becomes_possible
      σ75_consistency_check_FAILS
      agent_rolls_back_proof_atoms_to_last_consistent_state
      (this_is_paraconsistent_recovery_no_explosion_into_trivialism)
  }
}

