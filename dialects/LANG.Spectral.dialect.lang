§|DIALECT_SPECTRAL|COMPRESS{
  functor      = Π_expire_Spectral : State_Spectral* → Residue_Spectral
  axes         = {spectral, entropy_E, mu_Bn}
  ratio        = 0.35_of_full_Residue_size
  norm_guard   = ||terminal|| < 0.999
  adiabatic_c  = dI_Spectral/dt ≈ 0_within_dialect_section_space
  tag          = HYPOTHESIS_dialect_compression_preserves_semantic_content
}

§|DIALECT_SPECTRAL|DECOMP{
  decomp_path  = Residue_Spectral ->^embed Residue_full ->^Π_expand State_full
  embed_map    = {terminal=prior_default_terminal, spectral=R_D.spectral, trace=prior_default_trace, transport_gen=prior_default_transport_gen, mu_Bn=R_D.mu_Bn, entropy_E=R_D.entropy_E}
  axes_present = ['spectral', 'entropy_E', 'mu_Bn']
  axes_default = ['terminal', 'trace', 'transport_gen']
  info_loss    = 1 - 0.35 = 0.65_fraction_lost_in_D_residue
  reconstruct  = Π_expand(embed(R_D)) recovers_State_full_approximately
}

