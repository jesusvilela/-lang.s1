§|DIALECT_HYPERBOLICMIND|SORTS{
  sort.EpistemicFoundation = Continent I: linguistic precision, architectural thinking, truth reverence
  sort.TemporalValley = Continent II: aggressive patience, sustained deep work, ambiguity tolerance
  sort.EmotionalCitadel = Continent III: ego-detachment, equanimity under load, aesthetic drive
