(* §-LANG S1 Core — bounded, line-oriented grammar.

   Source text is UTF-8. Before applying the grammar:
   1. split the source into physical lines;
   2. trim ASCII space/tab at both ends of each line;
   3. discard blank lines and lines whose first two retained characters are //;
   4. require at least one retained line;
   5. parse exactly one statement from each retained line.

   Inline comments are outside S1 Core. Canonical S1 uses ASCII space/tab as
   horizontal whitespace. Implementations may accept additional whitespace as
   an extension, but conformance does not depend on it. *)

program        = statement , { retained-line-break , statement } ;
retained-line-break
               = ? boundary between retained physical lines after preprocessing ? ;

statement      = let-statement
               | emit-statement
               | assert-statement
               | evidence-statement ;

let-statement  = "§let" , hspace1 , identifier , hspace , "=" , hspace , expression ;
emit-statement = "§emit" , hspace1 , expression ;
assert-statement
               = "§assert" , hspace1 , expression , hspace , "==" , hspace , expression ;
evidence-statement
               = "§evidence" , hspace1 , evidence-id , hspace1 ,
                 "[" , evidence-tag , "]" , hspace1 , string ;

expression     = literal
               | identifier
               | call ;

call           = identifier , hspace , "(" , hspace ,
                 [ expression , { hspace , "," , hspace , expression } ] ,
                 hspace , ")" ;

literal        = number | string | "true" | "false" | "null" ;
evidence-tag   = "P" | "A" | "M" | "H" | "S" | "R" ;

identifier     = letter-or-underscore , { letter | digit | "_" } ;
evidence-id    = evidence-id-char , { evidence-id-char } ;

letter-or-underscore = letter | "_" ;
evidence-id-char = letter | digit | "_" | "." | "-" ;

hspace         = { " " | "\t" } ;
hspace1        = ( " " | "\t" ) , hspace ;

letter         = ? ASCII A-Z or a-z ? ;
digit          = ? ASCII 0-9 ? ;
string         = ? JSON double-quoted string literal ? ;

integer-part   = digit , { digit } ;
fraction       = "." , { digit } ;
number         = [ "-" ] ,
                 ( integer-part , [ fraction ]
                 | "." , digit , { digit } ) ;
